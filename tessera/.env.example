# ── Core ─────────────────────────────────────────────────────────────────────
# NODE_ENV is read from the real environment (it defaults to development).
# Set NODE_ENV=production on your host, not in this file.
# Port the API server listens on. In production it also serves the built client.
PORT=8787
# Public origin of the app as users see it. In development this is the Vite
# dev server (which proxies /api to PORT); in production it is your domain.
APP_URL=http://localhost:5173
DATABASE_URL=postgres://tessera:tessera@127.0.0.1:5432/tessera_dev
# Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-please-32chars
LOG_LEVEL=info
# Set to 1 when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=0

# ── Google sign-in (optional; the button is hidden when unset) ───────────────
# Authorised redirect URI: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email ────────────────────────────────────────────────────────────────────
# file  = write each message as JSON to .data/outbox (development default)
# smtp  = send through SMTP_URL
EMAIL_TRANSPORT=file
SMTP_URL=
EMAIL_FROM="Tessera <no-reply@localhost>"

# ── Object storage for images and audio ──────────────────────────────────────
# local = files under STORAGE_LOCAL_DIR; s3 = any S3-compatible bucket
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/uploads
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=0

# ── Deployment mode ──────────────────────────────────────────────────────────
# development (default), preview or production (default when NODE_ENV=production).
# preview: demo data, test payments and test AI unless keys are set, no
# search indexing. production: refuses test providers, demo data and a missing
# BETTER_AUTH_SECRET. See docs/DEPLOYMENT.md.
APP_ENV=
# Apply migrations / load demo data at start-up (both default on in preview).
MIGRATE_ON_START=
SEED_DEMO=
# Reported by /api/health, e.g. a commit hash.
APP_VERSION=

# ── AI (Claude) ──────────────────────────────────────────────────────────────
# anthropic = call the Anthropic API (needs ANTHROPIC_API_KEY)
# mock      = canned output for tests and offline development
# off       = AI features hidden
# Defaults to anthropic when a key is present, otherwise off.
AI_PROVIDER=
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5.
AI_MODEL=

# ── Payments ─────────────────────────────────────────────────────────────────
# stripe = Stripe Checkout (use test-mode keys); mock = local fake checkout; off
# Defaults to stripe when STRIPE_SECRET_KEY is present, otherwise off.
PAYMENTS_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ── Web push reminders (optional) ────────────────────────────────────────────
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# The server runs reminders and cleanup on an in-process timer. On serverless
# hosts set RUN_SCHEDULER=0 and call POST /api/internal/cron with this secret.
RUN_SCHEDULER=1
CRON_SECRET=

# ── Error reporting (optional) ───────────────────────────────────────────────
# Unhandled server and client errors are POSTed here as JSON.
ERROR_WEBHOOK_URL=
