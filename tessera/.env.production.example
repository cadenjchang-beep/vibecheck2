# Production settings for compose.yaml (or any container host).
# Copy to .env.production and fill in. Never commit the filled-in copy.

# ── Required ────────────────────────────────────────────────────────────────
# Public https origin, no trailing slash.
APP_URL=https://tessera.example.com
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Database password used by compose.yaml (ignored if you set DATABASE_URL on a
# managed database instead).
POSTGRES_PASSWORD=
# Behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=1

# ── Email (needed for verification, password reset and reminders) ───────────
SMTP_URL=smtps://user:password@smtp.example.com:465
EMAIL_FROM=Tessera <no-reply@tessera.example.com>

# ── Uploaded images and audio ───────────────────────────────────────────────
# local keeps files in the app-data volume; use s3 when running several
# instances or on hosts without persistent disks.
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── Optional services (each feature is hidden when not configured) ──────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ANTHROPIC_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@tessera.example.com

# ── Operations ──────────────────────────────────────────────────────────────
LOG_LEVEL=info
# ERROR_WEBHOOK_URL=
# With several app instances, set RUN_SCHEDULER=0 and call
# POST /api/internal/cron with header x-cron-secret every 5 minutes.
RUN_SCHEDULER=1
# CRON_SECRET=
