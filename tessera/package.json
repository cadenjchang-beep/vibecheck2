{
  "name": "tessera",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env src/server/main.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:api",
    "build:web": "NODE_ENV=production vite build",
    "build:api": "node scripts/build-server.mjs",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/server/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/server/db/seed.ts",
    "check:contrast": "node scripts/check-contrast.mjs",
    "e2e:serve": "node scripts/e2e-server.mjs",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@aws-sdk/client-s3": "^3.1167.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@hono/node-server": "^2.1.7",
    "@tanstack/react-query": "^5.107.1",
    "better-auth": "^1.7.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.72.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sonner": "^2.0.8",
    "stripe": "^23.1.0",
    "tailwind-merge": "^3.7.0",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.2.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
